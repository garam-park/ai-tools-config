# macOS metadata
.DS_Store
._*
.Spotlight-V100
.Trashes

# Extended attributes (xattr 등)
*.xattr

# 임시 백업
*.bak
*.tmp
*.swp
*~

# 다른 도구/환경이 만든 노이즈
.idea/
.fleet/
*.log

# VS Code: 프로젝트 MCP 설정만 추적 (.omm 이 provider 로 등록한 파일)
# .vscode/ 통째 제외는 하위 파일 재포함이 불가능하므로 .vscode/* 로 둔다
.vscode/*
!.vscode/mcp.json

# 향후 비밀값/로컬 전용 파일 안전망 (실수로 추가되어도 추적 안 됨)
.env
.env.tsk
.env.local
*.local
__pycache__/
*.py[cod]
.agents/skills/import-global-skill/settings.local.json
